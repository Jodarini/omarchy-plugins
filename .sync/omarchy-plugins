#!/bin/bash
# omarchy-plugins: keep ~/.config/omarchy/plugins in sync across machines.
#
# The plugins folder itself is the git checkout, so the shell's inotify
# watcher hot-reloads a plugin the moment a pull rewrites its files.
#
#   omarchy-plugins sync [--quiet]   pull (and push committed work) now
#   omarchy-plugins push [message]   commit every change and push it
#   omarchy-plugins status           what's local, what's upstream
#   omarchy-plugins import <git-url> [id]
#                                    bring an existing plugin repo in, history included
#   omarchy-plugins auto on|off      the systemd timer that runs `sync` on its own
#   omarchy-plugins log              recent auto-sync output

set -uo pipefail

DIR="$HOME/.config/omarchy/plugins"
BRANCH=main
UNIT=omarchy-plugins-sync
QUIET=0

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"

say() { (( QUIET )) || echo "$*"; }

warn() {
  echo "omarchy-plugins: $*" >&2
  command -v notify-send >/dev/null && notify-send -a "Omarchy plugins" -u normal "Plugin sync" "$*" 2>/dev/null
  return 0
}

die() { echo "omarchy-plugins: $*" >&2; exit 1; }

g() { git -C "$DIR" "$@"; }

[[ -d $DIR/.git ]] || die "$DIR is not a git checkout; run the installer first"

reload_shell() {
  command -v omarchy-shell >/dev/null || return 0
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
}

# Validate every plugin touched between two commits, so a bad push is loud.
validate_changed() {
  local from="$1" to="$2" id
  command -v omarchy-plugin-validate >/dev/null || return 0
  while IFS= read -r id; do
    [[ -f $DIR/$id/manifest.json ]] || continue
    omarchy-plugin-validate "$DIR/$id" >/dev/null 2>&1 ||
      warn "$id failed validation after sync; check: omarchy plugin validate $DIR/$id"
  done < <(g diff --name-only "$from" "$to" | cut -d/ -f1 | sort -u | grep -v '^\.')
}

summarize() {
  local from="$1" to="$2" ids
  ids=$(g diff --name-only "$from" "$to" | cut -d/ -f1 | sort -u | grep -v '^\.' | paste -sd, - | sed 's/,/, /g')
  [[ -n $ids ]] && say "Updated: $ids" && (( QUIET )) &&
    command -v notify-send >/dev/null && notify-send -a "Omarchy plugins" "Plugins updated" "$ids" 2>/dev/null
  return 0
}

cmd_sync() {
  [[ ${1:-} == --quiet ]] && QUIET=1

  if [[ -e $DIR/.git/rebase-merge || -e $DIR/.git/rebase-apply || -e $DIR/.git/MERGE_HEAD ]]; then
    warn "a rebase or merge is in progress in $DIR; finish it by hand"
    return 1
  fi

  # Offline is normal for a laptop; don't nag about it.
  g fetch --quiet origin "$BRANCH" 2>/dev/null || { say "Fetch failed (offline?)."; return 0; }

  local before local remote base
  before=$(g rev-parse HEAD)
  local=$before
  remote=$(g rev-parse "origin/$BRANCH")
  base=$(g merge-base HEAD "origin/$BRANCH")

  if [[ $local == "$remote" ]]; then
    say "Up to date."
    return 0
  fi

  if [[ $local == "$base" ]]; then
    # Behind. ff-only with uncommitted edits still works when the files
    # don't overlap; when they do, git refuses and nothing is lost.
    if ! g merge --ff-only --quiet "origin/$BRANCH" 2>/dev/null; then
      warn "can't fast-forward: you have uncommitted edits to files that changed upstream. Run 'omarchy-plugins push' or stash them."
      return 1
    fi
  elif [[ $remote == "$base" ]]; then
    say "Pushing local commits."
    g push --quiet origin "$BRANCH" || { warn "push failed"; return 1; }
    return 0
  else
    say "Diverged; rebasing local commits onto upstream."
    if ! g rebase --autostash --quiet "origin/$BRANCH" >/dev/null 2>&1; then
      g rebase --abort >/dev/null 2>&1
      warn "local and upstream changes conflict; resolve by hand in $DIR"
      return 1
    fi
    g push --quiet origin "$BRANCH" || warn "push failed after rebase"
  fi

  validate_changed "$before" HEAD
  summarize "$before" HEAD
  reload_shell
}

cmd_push() {
  local msg="${*:-}"
  g add -A
  if g diff --cached --quiet; then
    say "Nothing to commit."
  else
    if [[ -z $msg ]]; then
      local ids
      ids=$(g diff --cached --name-only | cut -d/ -f1 | sort -u | grep -v '^\.' | paste -sd, - | sed 's/,/, /g')
      msg="Update ${ids:-sync tooling} from $(hostname)"
    fi
    g commit --quiet -m "$msg" || die "commit failed"
    say "Committed: $msg"
  fi
  cmd_sync
}

cmd_status() {
  g fetch --quiet origin "$BRANCH" 2>/dev/null || echo "(fetch failed, showing last known upstream)"
  g status -sb
  echo
  echo "Ahead/behind upstream: $(g rev-list --left-right --count "HEAD...origin/$BRANCH" | awk '{print $1" ahead, "$2" behind"}')"
  echo "Auto-sync timer: $(systemctl --user is-active "$UNIT.timer" 2>/dev/null)"
}

cmd_import() {
  local url="${1:-}" id="${2:-}"
  [[ -n $url ]] || die "usage: omarchy-plugins import <git-url> [id]"
  if [[ -z $id ]]; then
    local tmp
    tmp=$(mktemp -d)
    git clone --quiet --depth 1 -- "$url" "$tmp/p" || { rm -rf "$tmp"; die "clone failed"; }
    id=$(jq -r '.id // empty' "$tmp/p/manifest.json" 2>/dev/null)
    rm -rf "$tmp"
    [[ -n $id ]] || die "no id in the repo's manifest.json; pass one explicitly"
  fi
  [[ ! -e $DIR/$id ]] || die "$DIR/$id already exists (if it's a standalone clone, move it aside first)"
  g diff --quiet && g diff --cached --quiet || die "commit or stash your changes first"
  g subtree add --prefix="$id" "$url" HEAD || die "subtree import failed"
  if g check-ignore -q "$id/manifest.json"; then
    echo "!/$id/" >>"$DIR/.gitignore"
    g add -f "$id" .gitignore && g commit --quiet -m "Track $id"
  fi
  say "Imported $id. Push it with: omarchy-plugins sync"
  reload_shell
}

cmd_auto() {
  local unit_dir="$HOME/.config/systemd/user"
  case "${1:-}" in
  on)
    mkdir -p "$unit_dir"
    cat >"$unit_dir/$UNIT.service" <<EOF
[Unit]
Description=Sync Omarchy plugins with GitHub
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/omarchy-plugins sync --quiet
EOF
    cat >"$unit_dir/$UNIT.timer" <<EOF
[Unit]
Description=Sync Omarchy plugins with GitHub periodically

[Timer]
OnStartupSec=1min
OnUnitActiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
EOF
    systemctl --user daemon-reload
    systemctl --user enable --now "$UNIT.timer" >/dev/null
    say "Auto-sync on: every 10 minutes and 1 minute after login."
    ;;
  off)
    systemctl --user disable --now "$UNIT.timer" >/dev/null 2>&1
    rm -f "$unit_dir/$UNIT.service" "$unit_dir/$UNIT.timer"
    systemctl --user daemon-reload
    say "Auto-sync off."
    ;;
  *) die "usage: omarchy-plugins auto on|off" ;;
  esac
}

case "${1:-}" in
sync) shift; cmd_sync "$@" ;;
push) shift; cmd_push "$@" ;;
status) cmd_status ;;
import) shift; cmd_import "$@" ;;
auto) shift; cmd_auto "$@" ;;
log) journalctl --user -u "$UNIT.service" -n 50 --no-pager ;;
*) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
